# =============================================================================
# BelgoBase environment template
#
# NEVER put secrets in NEXT_PUBLIC_* variables — those are embedded in the
# browser bundle. Server-only secrets belong in unprefixed variables below.
# =============================================================================

# --- Server-only secrets / private config ------------------------------------

# Resend — required for contact / demo request emails
RESEND_API_KEY=re_xxxxxxxx

# Company inbox for internal demo/contact notifications.
# Do NOT use noreply@belgobase.be — that address is send-only.
ADMIN_EMAIL=your-company-email@example.com

# Optional fallback if ADMIN_EMAIL is unset (defaults to site contact email).
# CONTACT_EMAIL=your-company-email@example.com

# Verified sender identity (From). Bare address is fine — wrapped as BelgoBase <…>.
# Prefer FROM_EMAIL; RESEND_FROM_EMAIL is still accepted for backwards compatibility.
FROM_EMAIL=noreply@belgobase.be
# RESEND_FROM_EMAIL=BelgoBase <noreply@belgobase.be>

# Optional contact-mail budget per 10-minute window (1..100, default 10).
# Distinct requests can use the whole budget. An identical retry reuses its slot.
# Resend stores the slot keys, so the cap holds across serverless instances.
# CONTACT_MAIL_SLOTS=10

# Server-side only: same-origin web gateway target. Never prefix this with NEXT_PUBLIC.
# Production requires HTTPS; localhost HTTP is accepted only in development.
# BELGOBASE_WEB_BACKEND_URL=https://api.belgobase.be/web/

# Login mail uses the existing RESEND_API_KEY and verified FROM_EMAIL above.
# The VPS mail-signing PRIVATE key stays on the VPS. Only its public key is
# pinned in src/lib/workspace/mail-relay-public-key.ts before publication.

# Cloudflare Turnstile — required in production for contact, login, and enrollment.
# Create a widget at https://dash.cloudflare.com/ → Turnstile.
# Site key is public (browser). Secret key stays server-side only.
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Without TURNSTILE_SECRET_KEY, production rejects those flows (fail closed).
# Local development without keys skips verification so offline tests still run.

# --- Public (browser-visible) overrides --------------------------------------

# Optional — canonical site URL for SEO metadata
# NEXT_PUBLIC_SITE_URL=https://belgobase.com

# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Optional Google measurement overrides (IDs are public marketing identifiers,
# not credentials). Leave unset to use the built-in production defaults.
# An empty NEXT_PUBLIC_GOOGLE_ADS_ID disables website measurement entirely.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-xxxxxxxx
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=xxxxxxxxxxxx
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
